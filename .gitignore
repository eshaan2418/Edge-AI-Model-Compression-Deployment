# Framework run outputs (generated: experiment DB, benchmarks, demo, pareto,
# artifacts, sweeps, plots, surrogates). Anchored to the repo root so the tracked
# source package edge_ai_compression/results/ handling stays explicit below.
edge_ai_compression/results/
/results/
/reports/
/configs/generated/

# Data and models (keep large/generated out of git).
# Anchored to the repo root so the source packages edge_ai_compression/data/
# and edge_ai_compression/models/ are NOT ignored. Ignoring the directory
# *contents* (/*) rather than the directory itself lets the README
# placeholders be re-included (git can't un-ignore a file whose parent dir is
# ignored).
/data/*
!/data/README.md
/models/*
!/models/README.md

# IDEs
.vscode/
.idea/
